# Copy this file to .env and fill in your values

# Your Anthropic API key (console.anthropic.com -> API Keys). This is a SEPARATE product/billing
# from a claude.ai subscription - a Claude Pro/Max chat plan does not include API access.
# Used only when a user clicks "Run fact-check" - never called automatically/on a schedule.
ANTHROPIC_API_KEY=...

# Claude model used for fact-checking (must support the web_search server tool)
ANTHROPIC_MODEL=claude-sonnet-5

# Web dashboard port
PORT=3400

# URL of the B-Side Universe portal, used by the "Back to portal" button
BSIDE_UNIVERSE_URL=http://localhost:3100

# URL of the B-Side Settings app, used to redirect unauthenticated visitors to log in
BSIDE_SETTINGS_URL=http://localhost:3300

# Shared signing secret for session/service auth tokens. MUST be the exact same value
# in every B-Side service's .env (hunter, universe, universe-agent, settings, market-research) -
# generate once with `openssl rand -hex 32` and copy it everywhere.
AUTH_SECRET=
